<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.wpunit13</groupId>
    <artifactId>spark-mutator-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>spark-mutator-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>spark-mutator-maven-plugin</name>
  <description>
    Maven plugin for Java and Scala pipelines.

    CURRENT STATUS: PLACEHOLDER. The single MutateMojo throws
    MojoExecutionException. The Java/Scala orchestration described in
    ARCHITECTURE.md section 5.4 (test-classpath introspection, matching
    shim resolution via Aether, Surefire/Failsafe argLine injection, and the
    baseline/mutation loop) is NOT implemented.

    The module exists so that:
      1. the full reactor builds and installs cleanly, and
      2. the artifact coordinate io.github.wpunit13:spark-mutator-maven-plugin
         quoted in the project README actually resolves.

    Use the pytest-spark-mutator Python plugin for PySpark pipelines; that
    track is complete.
  </description>

  <properties>
    <!--
      Prefix for goal invocation: mvn spark-mutator:mutate
      Without this, Maven derives the prefix from the artifactId, which would
      also give "spark-mutator" here, but pinning it makes the contract
      explicit and stable if the artifactId ever changes.
    -->
    <goalPrefix>spark-mutator</goalPrefix>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>mutator-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven.plugin.tools.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <goalPrefix>${goalPrefix}</goalPrefix>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
