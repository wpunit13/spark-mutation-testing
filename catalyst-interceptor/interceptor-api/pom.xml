<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.wpunit13</groupId>
    <artifactId>spark-mutator-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>interceptor-api</artifactId>
  <packaging>jar</packaging>

  <name>interceptor-api</name>
  <description>
    Spark-agnostic SPI: PlanMutatorShim, OperatorType, NodeCoordinate,
    NodeCoordinateFactory, MutationCandidate, ShimMutationException,
    SparkShimVersion.

    ARCHITECTURAL INVARIANT: this module may reference only the TOP-LEVEL
    Catalyst types needed in SPI signatures (LogicalPlan, Expression). It must
    NOT import or pattern-match any concrete case class such as Join, Filter,
    Aggregate, Window or Project. Those signatures change between Spark minor
    versions; confining them to interceptor-spark-* is the entire point of
    the shim architecture.

    Verify with:
      grep -rn "plans.logical.Join\|plans.logical.Filter\|catalyst.expressions" \
        catalyst-interceptor/interceptor-api/src/main
    which must return no matches.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      NodeCoordinateFactory delegates all hashing to
      DeterministicHasher.hashToHex so that NodeCoordinate and MutantID are
      guaranteed to share one implementation. This is the only reason the
      Scala SPI depends on the Java core.
    -->
    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>mutator-core</artifactId>
    </dependency>

    <!--
      spark-catalyst, not spark-sql: LogicalPlan and Expression live in
      catalyst, and depending on the narrower artifact keeps the compile
      surface as small as possible.
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-catalyst_${scala.binary.version}</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <!--
        Surefire is disabled in every Scala module: ScalaTest specs are
        discovered and run by scalatest-maven-plugin instead. Leaving both
        enabled makes Surefire report "no tests" and can mask real failures.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
