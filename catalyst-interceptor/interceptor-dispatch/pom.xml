<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.wpunit13</groupId>
    <artifactId>spark-mutator-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>interceptor-dispatch</artifactId>
  <packaging>jar</packaging>

  <name>interceptor-dispatch</name>
  <description>
    ShimDispatcher: resolves exactly one PlanMutatorShim at runtime via
    java.util.ServiceLoader.

    ARCHITECTURAL INVARIANT: no dependency of any scope (compile, provided,
    or runtime) on ANY interceptor-spark-* module. The concrete shim is found
    reflectively from META-INF/services at runtime. A direct dependency here
    would defeat the multi-version strategy and couple the dispatcher to one
    Spark release.

    Note the deliberate absence of a test-scope shim dependency too: the
    zero-implementation and multiple-implementation error paths are unit
    tested through an injected List/ClassLoader seam, not by putting a real
    shim on the test classpath. End-to-end ServiceLoader resolution is
    verified in interceptor-runtime, which does have a test-scope shim.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>interceptor-api</artifactId>
    </dependency>

    <!--
      interceptor-api's own Spark dependency is provided scope and therefore
      not transitive, but ShimDispatcher's signature mentions PlanMutatorShim,
      whose supertypes reference Catalyst types. Re-declare provided here so
      compilation resolves.
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-catalyst_${scala.binary.version}</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
