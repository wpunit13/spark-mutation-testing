<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.wpunit13</groupId>
    <artifactId>spark-mutator-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>interceptor-runtime</artifactId>
  <packaging>jar</packaging>

  <name>interceptor-runtime</name>
  <description>
    MutatorSparkExtension and CatalystMutationRule: the version-agnostic
    Catalyst integration layer.

    MutatorSparkExtension is the class named in
    spark.sql.extensions=io.github.wpunit13.mutator.MutatorSparkExtension,
    so this module's classes MUST be present on the driver classpath at
    runtime. They reach the PySpark driver inside the shaded fat jar produced
    by interceptor-spark-3.5_2.13 (see that module's shade configuration).

    This module deliberately does NOT depend on any interceptor-spark-* module
    at compile scope; the shim arrives via ShimDispatcher/ServiceLoader.
    It DOES depend on one at TEST scope, because the integration tests need a
    real shim on the classpath to exercise end-to-end ServiceLoader
    resolution, which is the correct place for such a dependency.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>interceptor-api</artifactId>
    </dependency>

    <!-- Permitted: transitively pulls only interceptor-api, no concrete shim. -->
    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>interceptor-dispatch</artifactId>
    </dependency>

    <!-- MutantRegistry, DeterministicHasher, MutationCatalogAccess. -->
    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>mutator-core</artifactId>
    </dependency>

    <!--
      spark-sql (not just catalyst) because SparkSessionExtensions lives in
      org.apache.spark.sql. Provided: supplied by the consumer at runtime.
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      TEST SCOPE ONLY. Puts a real PlanMutatorShim + its META-INF/services
      registration on the test classpath so CatalystMutationRuleSpec can
      verify the full extension -> dispatcher -> shim -> mutation path.
      Never promote this to compile or provided scope.
    -->
    <dependency>
      <groupId>io.github.wpunit13</groupId>
      <artifactId>interceptor-spark-3.5_2.13</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
